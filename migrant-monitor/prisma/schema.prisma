// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  PASSPORT
  PATENT
  REGISTRATION
  CHECK
  OTHER
}

model Employee {
  id           String    @id @default(cuid())
  fullName     String    // ФИО
  phone        String?   // Телефон (только цифры)
  department   String?   // Отдел/Локация
  comment      String?   // Комментарий
  sent         Boolean   @default(false) // Статус отправки
  
  // Даты документов
  patentDate        DateTime?
  registrationDate  DateTime?
  passportDate      DateTime?
  checkDate         DateTime?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Связи
  documents    Document[]

  @@map("employees")
}

model Document {
  id           String      @id @default(cuid())
  employeeId   String
  type         DocumentType
  fileName     String      // Оригинальное имя файла
  mimeType     String      // MIME тип
  size         Int         // Размер в байтах
  storedAt     String      // Путь к файлу в файловой системе
  uploadedAt   DateTime    @default(now())

  // Связи
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Settings {
  id               Int     @id @default(1) // Singleton
  urgentDaysDefault Int    @default(7)     // Дни до срочности (по умолчанию)
  warnDaysDefault   Int    @default(30)    // Дни до предупреждения (по умолчанию)
  perFieldOverrides Json?  // Переопределения порогов по полям
  whatsappTemplate  String @default("Здравствуйте, {name}! {problems}. Пожалуйста, пришлите сканы.")
  
  updatedAt        DateTime @updatedAt @default(now())

  @@map("settings")
}